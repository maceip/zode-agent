{
  "name": "alto",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "main": "dist/node/desktop/main.js",
  "description": "A dynamically reprogrammable Cordis GUI for Codex app-server.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "build": "npm run build:client && npm run build:server && npm run build:desktop-preload",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:desktop-preload": "esbuild src/desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/desktop/preload.cjs",
    "build:ghostty": "bash native/ghostty/build.sh",
    "build:mac-icon": "bash scripts/build-macos-icon.sh",
    "build:mac-app": "npm run build && npm run build:ghostty && npm run build:mac-icon && node scripts/build-macos-app.mjs",
    "build:mac-release": "npm run build && npm run build:ghostty && npm run build:mac-icon && node scripts/build-macos-app.mjs --portable",
    "install:mac-app": "npm run build && npm run build:ghostty && npm run build:mac-icon && node scripts/build-macos-app.mjs --install",
    "desktop": "npm run build && NODE_ENV=production electron .",
    "desktop:dev": "npm run build:server && npm run build:desktop-preload && electron . --development",
    "start": "NODE_ENV=production node dist/node/server/main.js",
    "test": "vitest run",
    "test:paper": "vitest run tests/cordis-paper.test.ts tests/cordis-runtime.test.ts tests/client-plugin-runtime.test.ts tests/client-extension-registry.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "design-system:audit": "node scripts/design-system-audit.mjs",
    "check": "npm run design-system:audit && npm run typecheck && npm run test && npm run build",
    "schema:codex": "codex app-server generate-json-schema --experimental --out schemas/codex"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pierre/diffs": "^1.3.5",
    "chokidar": "^5.0.0",
    "cordis": "4.0.0-rc.8",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "express": "^5.1.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.31.0",
    "mermaid": "^11.17.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "^43.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/block/alto.git"
  }
}
